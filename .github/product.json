{
  "$schema": "https://raw.githubusercontent.com/waveshareteam/esp32-repo-template/v1/schema/product.schema.json",
  "product": "ESP32-S3-DualEye-Touch-LCD-1.28",
  "product_url": "https://www.waveshare.net/shop/ESP32-S3-DualEye-Touch-LCD-1.28.htm",
  "tier": 0,
  "target": "esp32s3",
  "esp_idf": {
    "versions": [
      "v5.5.1"
    ]
  },
  "arduino": {
    "core": "3.2.0",
    "fqbn": "esp32:esp32:esp32s3:FlashSize=16M,FlashMode=qio120,PartitionScheme=esp_sr_16,PSRAM=opi,EventsCore=0,USBMode=hwcdc,CDCOnBoot=default"
  },
  "overrides": {
    "markdown_audit": {
      "classification_rules": [
        {
          "category": "embedded_upstream",
          "patterns": [
            "examples/esp-idf/LCD_06_Music_Player/components/chmorgan__esp-libhelix-mp3/**"
          ]
        },
        {
          "category": "embedded_upstream",
          "patterns": [
            "examples/esp-idf/Touch_01_Text_Number/components/espressif__esp-dsp/**"
          ]
        },
        {
          "category": "third_party",
          "patterns": [
            "examples/arduino/reference/touch-libraries/**"
          ]
        }
      ]
    }
  }
}
